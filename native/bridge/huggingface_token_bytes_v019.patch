+absl::StatusOr<std::vector<std::string>> HuggingFaceTokenizer::GetTokenBytes() const {
+  if (!token_bytes_.supported()) {
+    return absl::UnimplementedError(
+        "HuggingFace constrained decoding requires a ByteLevel decoder; "
+        "this tokenizer decoder has no lossless token-byte adapter.");
+  }
+  auto tokens = GetTokens();
+  for (size_t id = 0; id < tokens.size(); ++id) {
+    tokens[id] = token_bytes_.TokenBytes(tokens[id], id);
+  }
+  return tokens;
+}
