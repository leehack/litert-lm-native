+std::string WithDefaultJsonWhitespace(absl::string_view text) {
+  auto schema = nlohmann::ordered_json::parse(text.begin(), text.end(), nullptr,
+                                             false);
+  if (schema.is_boolean()) {
+    schema = nlohmann::ordered_json{{"allOf", {schema}}};
+  }
+  if (!schema.is_object()) return std::string(text);
+  if (!schema.contains("x-guidance")) {
+    schema["x-guidance"] = nlohmann::ordered_json::object();
+  }
+  auto& options = schema["x-guidance"];
+  if (!options.is_object() || options.contains("whitespace_pattern") ||
+      options.contains("whitespace_flexible")) {
+    return std::string(text);
+  }
+  // An unlimited skip lets greedy decoding spend the entire output budget on
+  // insignificant whitespace. The once-per-gap bound preserves JSON values.
+  options["whitespace_pattern"] = R"([\x20\x0A\x0D\x09]{1,8})";
+  return schema.dump();
+}
 
