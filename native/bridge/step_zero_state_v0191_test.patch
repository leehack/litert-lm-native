+#if defined(__APPLE__) && TARGET_OS_OSX
+TEST_F(LlmLiteRtCompiledModelExecutorLinearAttentionTest,
+       SamplerLookaheadEligibilityOnMacOS) {
+  struct Case {
+    Backend backend;
+    bool linear_attention;
+    bool caller_enabled;
+    int first_decode_graphs;
+  };
+  const Case cases[] = {
+      {Backend::GPU, true, true, 1},
+      {Backend::GPU, false, true, 2},
+      {Backend::CPU, true, true, 1},
+      {Backend::GPU, true, false, 1},
+  };
+  for (const auto& test : cases) {
+    SCOPED_TRACE(absl::StrCat(static_cast<int>(test.backend), "/",
+                              test.linear_attention, "/", test.caller_enabled));
+    proto::ExecutorMetadata metadata;
+    ASSERT_NO_FATAL_FAILURE(CreateExecutor("magic_test_none.tflite", false,
+                                           test.backend, test.caller_enabled));
+    if (test.linear_attention) {
+      for (const char* name : {"kv_cache_lc_0", "kv_cache_lr_0"}) {
+        auto* state = metadata.mutable_llm_executor_metadata()->add_state_buffers();
+        state->set_decode_input_name(name);
+        state->set_type(proto::StateBuffer::TYPE_LINEAR_ATTENTION);
+      }
+      // Provide the affected model's sampler metadata without changing the
+      // synthetic model's tensor names or its compiled state layout.
+      TestableLlmLiteRtCompiledModelExecutorStatic::SetSamplerMetadataForTest(
+          executor_.get(), &metadata);
+    }
+    int decode_graphs = 0;
+    executor_->UpdatePreGraphRunCallback(
+        [&decode_graphs](absl::string_view signature, int, auto&) {
+          if (signature == "decode") ++decode_graphs;
+        });
+    ASSERT_OK(Prefill());
+    ASSERT_OK(executor_->Decode());
+    EXPECT_EQ(decode_graphs, test.first_decode_graphs);
+    ASSERT_OK(executor_->Decode());
+    EXPECT_EQ(decode_graphs, test.first_decode_graphs + 1);
+    executor_.reset();
+    resources_.reset();
+    env_.reset();
+  }
+}
+#endif
