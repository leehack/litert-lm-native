 namespace {
 
+// litert-lm-native stream_proxy finish-reason wire values.
+enum FinishReason : int {
+  kFinishReasonUnknown = 0,
+  kFinishReasonStop = 1,
+  kFinishReasonLength = 2,
+  kFinishReasonContextExhausted = 3,
+  kFinishReasonCancelled = 4,
+  kFinishReasonError = 5,
+};
+
+int ToFinishReason(litert::lm::DecodeStopReason reason) {
+  switch (reason) {
+    case litert::lm::DecodeStopReason::kStopToken:
+      return kFinishReasonStop;
+    case litert::lm::DecodeStopReason::kMaxOutputTokens:
+      return kFinishReasonLength;
+    case litert::lm::DecodeStopReason::kMaxNumTokens:
+      return kFinishReasonContextExhausted;
+    case litert::lm::DecodeStopReason::kUnspecified:
+      return kFinishReasonUnknown;
+  }
+  return kFinishReasonUnknown;
+}
